# -------------------------------------------------------------------
# 1. PYTHON AND VIRTUAL ENVIRONMENT
# -------------------------------------------------------------------

# Ignore all bytecode files
*.pyc
*~$
__pycache__/
.pytest_cache/

# Ignore the virtual environment folder
# Change 'venv' to your environment name if it's different (e.g., 'env', '.venv')
venv/
env/

# Dependency installers (optional, but clean)
dist/
build/
*.egg-info/


# -------------------------------------------------------------------
# 2. OPERATING SYSTEM AND EDITOR FILES
# -------------------------------------------------------------------

# macOS specific files
.DS_Store

# Windows specific files
Thumbs.db

# Common Editor/IDE files (VS Code, Sublime Text, Vim)
# .vscode/
*.swp
*~
.idea/

# Local settings file containing SECRET_KEY and database credentials
# If you are using a pattern like settings/local.py
# settings/local.py

# A common pattern is to use a .env file to load settings
# .env
.flaskenv


# SQLite Database file
# The default name is db.sqlite3, adjust if you named it differently
db.sqlite3

# Media and uploaded content
/media/
/static_collected/

# Node dependencies
node_modules/

# React Native specific output
npm-debug.log*
yarn-debug.log*
yarn-error.log*