# Establece el comportamiento por defecto para evitar problemas si alguien no tiene `core.autocrlf` configurado.
* text=auto eol=lf

# Archivos que SIEMPRE deben tener finales de línea LF (Linux/macOS)
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.conf text eol=lf